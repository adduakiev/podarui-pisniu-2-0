# Track only the application and curated project documentation.
/*
!/.gitignore
!/song-system/
!/office-start/
!/PODARUI_PISNIU_2_0_VIRTUAL_OFFICE.md
!/PODARUI_PISNIU_2_0_COMMUNICATION_ACCEPTANCE.md

# Private runtime data and local artifacts, at any level.
**/.env*
!**/.env.example
**/data/
**/node_modules/
**/.next/
**/*.tsbuildinfo
**/.DS_Store
**/verification/*.png
**/verification/*.jpg
**/*.log

# Private cloud development setup.
!/.devcontainer/
!/README.md
!/CLOUD_SETUP.md
