LOCAL_ONLY=1
ADMIN_PASSWORD=replace-with-long-local-password
SESSION_SECRET=replace-with-random-secret-at-least-32-characters

# Optional Instagram Direct staging webhook. Leave off until the staging checklist is complete.
INSTAGRAM_DIRECT_ENABLED=0
# DATA_DIR=/absolute/path/to/isolated-staging-data
# INSTAGRAM_DIRECT_ACCOUNT_ID=
# INSTAGRAM_DIRECT_API_VERSION=
# INSTAGRAM_DIRECT_ACCESS_TOKEN=
# INSTAGRAM_DIRECT_APP_SECRET=
# INSTAGRAM_DIRECT_VERIFY_TOKEN=

# Optional server-side Responses interpreter; off unless explicitly enabled.
OLENA_RESPONSES_ENABLED=0
OLENA_MODEL=
OPENAI_API_KEY=
